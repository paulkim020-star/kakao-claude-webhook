# GPT <-> Claude + Slack 연동용 환경변수 예시
# 이 파일을 복사해 .env 로 만들고 값을 채우세요 (.env 는 커밋되지 않습니다).

# --- 필수: API 키 (직접 발급) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- 필수: Slack 연동 시 ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...

# --- 선택 ---
# OPENAI_MODEL=gpt-4o
# GPT_CLAUDE_MODEL=claude-opus-4-8
# SLACK_DIALOGUE_ROUNDS=3
